# Copy to .env.local for local development and fill in real values.
# Never commit .env.local — it is git-ignored.

# --- Database -----------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas recommended in production).
MONGODB_URI=mongodb+srv://gaganpalai987_db_user:<db_password>@portfolio.biipmmb.mongodb.net/?appName=portfolio&compressors=zlib

# --- Authentication (Auth.js) ---------------------------------------------------
# Secret used to sign/encrypt session tokens. Generate with: npx auth secret
#   or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Site -----------------------------------------------------------------------
# Public origin, used for canonical URLs, Open Graph, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudinary (images & resume PDFs) -------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: root folder for all uploads (default: portfolio)
CLOUDINARY_FOLDER=portfolio

# --- Initial admin account (used only by `npm run create-admin`) ----------------
# The app never reads these at runtime. Delete ADMIN_PASSWORD after the account
# is created, or leave it blank to be prompted instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
